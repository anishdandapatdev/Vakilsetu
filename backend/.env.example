NODE_ENV=development
PORT=8080
API_BIND_HOST=127.0.0.1
REQUIRE_HTTPS=false
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://vakilsetu:local-development-only@127.0.0.1:5432/vakilsetu
DATABASE_SSL=false
REDIS_URL=redis://127.0.0.1:6379
PUBLIC_APP_ORIGINS=http://127.0.0.1:8780,http://127.0.0.1:8781,http://localhost:3000
SESSION_SIGNING_KEY=replace-with-at-least-32-random-characters
OTP_HASH_PEPPER=replace-with-another-32-character-random-secret
ADMIN_SESSION_SIGNING_KEY=replace-with-a-separate-32-character-admin-secret
OTP_PROVIDER=development
DEVELOPMENT_OTP_CODE=123456
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
OBJECT_STORAGE_PROVIDER=configured
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
# Optional browser/device-visible signing endpoint when the API runs in Docker.
# Set to http://127.0.0.1:9000 for a local browser; use a reachable HTTPS host in production.
OBJECT_STORAGE_PUBLIC_ENDPOINT=
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_BUCKET=vakilsetu-development
OBJECT_STORAGE_ACCESS_KEY_ID=vakilsetu-local
OBJECT_STORAGE_SECRET_ACCESS_KEY=vakilsetu-local-secret-only
E2EE_PROTOCOL=vakilsetu-development-envelope-v1
PUSH_TOKEN_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
PUSH_PROVIDER=disabled
MALWARE_SCANNER_PROVIDER=development
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Omit to retain messages. Set 30-3650 only after approving a retention policy.
MESSAGE_RETENTION_DAYS=
